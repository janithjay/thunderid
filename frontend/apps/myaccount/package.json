{
  "private": true,
  "name": "@thunderid/myaccount",
  "version": "0.0.0",
  "description": "My Account, where users of a Data Plane manage their own profile, credentials, passkeys and sessions.",
  "keywords": [
    "thunderid",
    "myaccount",
    "app"
  ],
  "homepage": "https://github.com/thunder-id/thunderid/tree/main/frontend/apps/myaccount#readme",
  "bugs": {
    "url": "https://github.com/thunder-id/thunderid/issues"
  },
  "author": "The ThunderID Authors",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./preview": "./src/preview/main.tsx"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thunder-id/thunderid",
    "directory": "frontend/apps/myaccount"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "clean": "pnpm clean:dist && pnpm clean:node_modules",
    "clean:dist": "rimraf dist",
    "clean:node_modules": "rimraf node_modules",
    "dev": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.app.json"
  },
  "dependencies": {
    "@thunderid/i18n": "workspace:^",
    "@thunderid/react": "link:../../../../javascript-sdks/packages/react",
    "@thunderid/react-router": "link:../../../../javascript-sdks/packages/react-router",
    "i18next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@thunderid/eslint-plugin": "workspace:^",
    "@thunderid/prettier-config": "workspace:^",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-basic-ssl": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
